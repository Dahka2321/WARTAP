{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": ""  
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"  
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=*, camera=*, geolocation=*, microphone=*"
        }
      ]
    }
  ]
}
